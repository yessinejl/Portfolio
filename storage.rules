rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Lecture publique pour afficher les images de projets sur le site
      allow read: if true;
      
      // Téléversement et suppression uniquement autorisés pour l'admin connecté
      allow write: if request.auth != null;
    }
  }
}
